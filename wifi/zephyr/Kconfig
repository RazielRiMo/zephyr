# Kconfig
# Opciones de configuración propias de la aplicación. Se fijan con valores
# por defecto aquí y se sobrescriben en prj.conf (o con `west build -t menuconfig`).

menu "Configuración del puente TCP/JSON (ESP32)"

config APP_WIFI_SSID
	string "SSID de la red Wi-Fi local"
	default "MI_RED_WIFI"
	help
	  Nombre (SSID) de la red Wi-Fi 2.4 GHz a la que se conectará la ESP32.
	  También puede modificarse en caliente antes de compilar editando
	  prj.conf, sin tocar el código C.

config APP_WIFI_PSK
	string "Contraseña (PSK) de la red Wi-Fi"
	default "MI_CONTRASENA"
	help
	  Contraseña de la red Wi-Fi (WPA2-PSK). Evita dejar credenciales
	  reales versionadas en un repositorio.

config APP_TCP_PORT
	int "Puerto TCP en el que escucha la ESP32"
	default 5000
	range 1 65535
	help
	  La ESP32 actúa como servidor TCP: escucha en este puerto a la espera
	  de que la aplicación de PC se conecte como cliente.

config APP_TELEMETRY_PERIOD_MS
	int "Período de la tarea de envío de telemetría (ms)"
	default 2000
	help
	  Cada cuánto tiempo la tarea periódica arma y envía una trama JSON de
	  telemetría (con datos simulados que cambian en cada ciclo) al
	  cliente TCP conectado, si lo hay.

endmenu

source "Kconfig.zephyr"
