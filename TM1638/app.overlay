#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>
/*
 * Patron "zephyr,user": forma estandar de Zephyr para pasarle GPIOs
 * sueltos a la aplicacion sin necesidad de escribir un devicetree
 * binding ni un driver formal.
 *
 * Al llamarse "app.overlay" y estar en la raiz del proyecto (no dentro
 * de boards/), Zephyr lo aplica automaticamente sin importar la placa
 * para la que compiles -- no hace falta pasar -DDTC_OVERLAY_FILE ni
 * tocar el CMakeLists.txt.
 *
 * Pines elegidos sobre el header estilo Arduino del Nucleo-F401RE
 * (libres por defecto, no pisan UART2/I2C1 que ya usa la placa):
 *   D2 -> STB   (PA10)
 *   D4 -> CLK   (PB5)
 *   D7 -> DIO   (PA8)
 * Para usar otros pines fisicos, solo hay que cambiar los numeros de
 * &arduino_header aqui abajo -- el resto del proyecto no cambia.
 */
/ {
	zephyr,user {
		tm1638-stb-gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>;
		tm1638-clk-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
		tm1638-dio-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;

		io-channels = <&adc1 0>, <&adc1 1>;
		io-channel-names = "temp", "lumens";
	};
};

/* DEVICETREE-MANAGER-BEGIN: generated region, do not edit inside this block */
&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;
    	pinctrl-names = "default";
    	pinctrl-0 = <&analog_pa0 &analog_pa1>;
    	status = "okay";
	channel@0{
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,resolution = <12>;
	};
	channel@1{
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,resolution = <12>;
	};


};
/* DEVICETREE-MANAGER-END */
